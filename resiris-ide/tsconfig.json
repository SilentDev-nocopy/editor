{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "outDir": "static/js",
    "rootDir": "static/ts",
    "strict": true,
    "noImplicitAny": true,
    "noEmitOnError": false,
    "sourceMap": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["static/ts/**/*.ts"]
}